{
  "name": "@dkships/pm-copilot",
  "version": "1.6.0",
  "description": "MCP server that triangulates support tickets, feature requests and AI support agent chats to help PMs decide what to build next",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pm-copilot": "dist/index.js"
  },
  "mcpName": "io.github.dkships/pm-copilot",
  "files": [
    "dist",
    "themes.config.json",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "test:watch": "vitest",
    "tool": "node scripts/call-tool.mjs",
    "eval": "node scripts/eval-themes.mjs",
    "audit:ci": "npm audit --omit=dev --audit-level=high",
    "prepublishOnly": "npm run build && npm test && npm run audit:ci"
  },
  "keywords": [
    "mcp",
    "product-management",
    "helpscout",
    "productlift",
    "chatbase",
    "customer-feedback",
    "prioritization"
  ],
  "license": "MIT",
  "author": "David Kelly <contact@dmkthinks.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkships/pm-copilot.git"
  },
  "bugs": {
    "url": "https://github.com/dkships/pm-copilot/issues"
  },
  "homepage": "https://github.com/dkships/pm-copilot#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
